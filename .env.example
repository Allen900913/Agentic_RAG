# =============================================
# OpenAI-compatible API 設定（skill_builder.py 使用，課程用 LiteLLM endpoint）
# =============================================
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_BASE_URL=https://litellm.netdb.csie.ncku.edu.tw

# =============================================
# Embedding / Rerank 模型設定（本地免費，HuggingFace 下載，無需 API Key）
# =============================================
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# =============================================
# Vector DB 設定
# 有設定 QDRANT_URL 時走 Docker server 模式（推薦，支援多 process 同時存取）
# 沒設定則 fallback 到 QDRANT_PATH 的 local embedded 模式（單一 process 排他鎖）
# =============================================
QDRANT_PATH=./qdrant_db
QDRANT_URL=http://localhost:6333

# =============================================
# SEC EDGAR 身份識別（edgartools 要求，填入任意真實聯絡資訊即可）
# 格式：Name email@domain.com
# =============================================
SEC_IDENTITY=Your Name your.email@example.com

# =============================================
# rag_query.py 生成用（Google GenAI SDK）
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================
# Eval 腳本用（Groq，4-key rotation 應對 TPD 限額）
# =============================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY2=your_groq_api_key2_here
GROQ_API_KEY3=your_groq_api_key3_here
GROQ_API_KEY4=your_groq_api_key4_here

# =============================================
# 選用：api_server.py NVIDIA NIM backend（OpenAI-compatible endpoint）
# =============================================
NVIDIA_API_KEY=your_nvidia_api_key_here

# =============================================
# 選用：api_server.py 切換生成後端（gemini | groq | nvidia）
# =============================================
LLM_BACKEND=gemini

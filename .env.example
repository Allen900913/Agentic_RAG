# 複製這份為 .env 後填入自己的值：cp .env.example .env
# ⚠ .env 已在 .gitignore 內，絕對不要提交真實金鑰。

# ── LLM（生成與判官）─────────────────────────────────────────
# LLM_BACKEND 決定 rag_query.call_llm 的預設供應商：nvidia / gemini / groq
LLM_BACKEND=nvidia

# NVIDIA NIM：預設模型 openai/gpt-oss-120b（agentic 檢索層用 20b）
# 取得：https://build.nvidia.com/  → 右上 Get API Key
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_API_KEY2=nvapi-your_second_key_here   # 選填，額度用完時的備援

# Groq：ingest 的表格摘要（llama-3.3-70b-versatile）
# 多把 key 是為了避開 TPD 限制，只填 GROQ_API_KEY 也能跑
GROQ_API_KEY=gsk_your_key_here
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=

# Gemini：模型名以 gemini-* 開頭時走這裡（選填）
GEMINI_API_KEY=your_gemini_key_here

# 校內 LiteLLM 代理（選填）
LITELLM_BASE_URL=https://litellm.netdb.csie.ncku.edu.tw
LITELLM_API_KEY=sk-your_litellm_key_here

# ── 向量資料庫 ───────────────────────────────────────────────
# 用 Docker 起 Qdrant 時填 QDRANT_URL；用本機檔案模式時填 QDRANT_PATH
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_db
QDRANT_API_KEY=                              # 本機 Qdrant 不需要，Cloud 才要

# 覆寫預設 collection（不設則用 rag_query.py 的預設值）
# RAG_COLLECTION=us_stock_rag_edgar_period

# ── 嵌入與重排序模型（HuggingFace，本機下載）────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 資料來源 ─────────────────────────────────────────────────
# SEC EDGAR 要求 User-Agent 帶真實聯絡資訊，否則會被擋
SEC_IDENTITY=Your Name your_email@example.com

# Tavily 網頁搜尋（agentic 的 web_search 節點，選填）
TAVILY_API_KEY=tvly-your_key_here

# ── A/B 實驗（選填）─────────────────────────────────────────
# 設了才啟用 llm_replay 重放快取；未設時完全 no-op
# RAG_REPLAY_CACHE=eval/replay_cache.json

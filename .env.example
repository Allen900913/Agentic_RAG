# =============================================
# OpenAI-compatible API 設定（程式使用 openai 套件呼叫）
# 助教提供的 LiteLLM Endpoint
# =============================================
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=https://litellm.netdb.csie.ncku.edu.tw

# =============================================
# Embedding Model 設定（sentence-transformers 本地免費）
# 完全免費，無需 API Key，程式首次執行會自動下載模型
# =============================================
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Vector DB 設定（ChromaDB，純 Python，無需 Docker）
# =============================================
CHROMA_PERSIST_DIR=./chroma_db

# =============================================
# SEC EDGAR 身份識別（edgartools 要求，填入任意真實聯絡資訊即可）
# 格式：Name email@domain.com
# =============================================
SEC_IDENTITY=allen abc123@gmail.com
